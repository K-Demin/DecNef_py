{
  "_comment": "Brain-pong realtime neurofeedback defaults. Keep scanner preprocessing settings in rt_settings.json; this file controls decoder interpretation, task behavior, and logging.",
  "TR": 1.0,
  "analysis_space": "t1",
  "decoder": {
    "pair": "scene_vehicle",
    "category_a": "scene",
    "category_b": "vehicle",
    "category_a_direction": "up",
    "category_b_direction": "down",
    "invert_score": false
  },
  "feedback": {
    "initial_ignore_volumes": 0,
    "feedback_delay_volumes": 0,
    "feedback_delay_sec": 0.0,
    "score_buffer_length": 256,
    "smoothing_window": 2,
    "zscore_mode": "reference",
    "feedback_transform": "signed_percentile",
    "clip_min": -1.0,
    "clip_max": 1.0,
    "gain": 1.0,
    "dead_zone": 0.1
  },
  "task": {
    "config_path": "task/Minjoo/brain_pong_inputs/config/defaults_delay.yaml",
    "levels_path": "task/Minjoo/brain_pong_inputs/config/levels.yaml",
    "n_blocks": 1,
    "trials_per_block": 3,
    "start_block": 1,
    "resume_from": null,
    "movement_mode": "position",
    "stop_at_peak": false,
    "return_to_center": false,
    "return_rate": 0.4,
    "max_paddle_speed": 0.4,
    "position_limits": [-0.9, 0.9],
    "wait_for_trigger_in_simulation": false
  },
  "logging": {
    "output_dir": "logs/brainpong",
    "save_frame_log": true,
    "save_score_log": true,
    "save_trial_log": true
  },
  "simulation": {
    "enabled": false,
    "input_method": "keyboard",
    "score_source": "sine",
    "replay_path": null
  }
}